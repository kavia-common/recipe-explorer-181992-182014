# Recipe Backend Environment

# Repository provider: "memory" (default) or "external"
RECIPE_DB_PROVIDER=memory

# External provider configuration (only if RECIPE_DB_PROVIDER=external)
RECIPE_DB_URL=
RECIPE_DB_API_KEY=

# CORS origins (comma-separated). Default allows local React dev server.
ALLOW_ORIGINS=http://localhost:3000

# Optional metadata
APP_TITLE=Recipe Explorer API
APP_VERSION=0.1.0
APP_DESCRIPTION=Backend API for a fullstack recipe application. Provides recipe browsing, search, and creation endpoints.
